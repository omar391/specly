{
  "name": "deep_nesting",
  "intent": "Test deep object nesting stability",
  "inputs": {
    "nested": {
      "type": "object",
      "properties": {
        "level1": {
          "type": "object",
          "properties": {
            "level2": {
              "type": "object",
              "properties": {
                "level3": {
                  "type": "object",
                  "properties": {
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "outputs": { "result": { "type": "boolean" } },
  "metadata": { "version": 1, "nesting_depth": 4 }
}
