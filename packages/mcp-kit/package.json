            "import": "./dist/node-instance/index.js",
            "types": "./dist/node-instance/index.d.ts"
        },
        "./server/express": {
            "import": "./dist/server/express/index.js",
            "types": "./dist/server/express/index.d.ts"
        },
        "./server": {
            "import": "./dist/server/index.js",
            "types": "./dist/server/index.d.ts"
        },
        "./server/edge": {
            "import": "./dist/server/edge/index.js",
            "types": "./dist/server/edge/index.d.ts"
        },
        "./server/handlers": {
            "import": "./dist/server/handlers.js",
            "types": "./dist/server/handlers.d.ts"
        },
        "./server/stdio": {
            "import": "./dist/server/stdio.js",
            "types": "./dist/server/stdio.d.ts"
        },
        "./utils/port-manager": {
            "import": "./dist/utils/port-manager.js",
