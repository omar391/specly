{
  "name": "specly",
  "version": "0.1.0",
  "description": "A Model Context Protocol server",
  "private": true,
  "type": "module",
  "bin": {
    "specly": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "pretest": "tsx scripts/ensure-node-test-runtime.ts",
    "build": "pnpm -w run build:server && pnpm --filter ui run build",
    "build:server": "rsbuild build",
    "build:ui": "pnpm --filter ui run build",
    "seed:specly": "tsx src/scripts/seed-specly.ts",
    "dev": "concurrently --names=\"MCP,UI\" --prefix-colors=\"blue,green\" \"pnpm -w run dev:server\" \"pnpm --filter ui run dev\"",
    "dev:server": "tsx --watch src/index.ts --stdio",
    "dev:ui": "pnpm --filter ui run dev",
    "serve": "pnpm -w run build && node build/index.js --port=8989",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:tool": "tsx src/cli.ts",
    "lint": "pnpm -w run lint:server && pnpm --filter ui run lint",
    "lint:server": "tsc --noEmit",
    "lint:ui": "pnpm --filter ui run lint",
    "inspector": "pnpx @modelcontextprotocol/inspector build/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "zod": "^3.25.74",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.4.5",
    "@rsbuild/plugin-react": "^1.3.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^20.19.4",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.4",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sqlite3"
    ],
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "esbuild"
    ]
  }
}
