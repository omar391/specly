{
    "name": "@omar391/specly-server",
    "version": "0.1.0",
    "description": "Specly MCP Server - Task management via Model Context Protocol",
    "private": true,
    "type": "module",
    "bin": {
        "specly": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "pretest": "tsx scripts/ensure-node-test-runtime.ts",
        "build": "rsbuild build",
        "dev": "tsx --watch src/index.ts --stdio",
        "serve": "pnpm run build && node dist/index.js --port=8989",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:tool": "tsx src/cli.ts",
        "lint": "tsc --noEmit",
        "inspector": "pnpx @modelcontextprotocol/inspector dist/index.js",
        "seed:specly": "tsx src/scripts/seed-specly.ts"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.6",
        "@modelcontextprotocol/sdk": "^1.15.0",
        "@omar391/mcp-kit": "workspace:*",
        "@types/uuid": "^10.0.0",
        "better-sqlite3": "^12.2.0",
        "drizzle-orm": "^0.44.2",
        "express": "^5.1.0",
        "hono": "^4.10.4",
        "http-proxy": "^1.18.1",
        "sqlite3": "^5.1.7",
        "uuid": "^11.1.0",
        "zod": "^3.25.74",
        "zod-to-json-schema": "^3.24.6"
    },
    "devDependencies": {
        "@rsbuild/core": "^1.4.5",
        "@types/better-sqlite3": "^7.6.13",
        "@types/express": "^5.0.3",
        "@types/http-proxy": "^1.17.16",
        "@types/node": "^20.19.4",
        "@types/supertest": "^2.0.16",
        "@vitest/coverage-c8": "^0.33.0",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "drizzle-kit": "^0.31.4",
        "supertest": "^7.1.1",
        "test-utils": "link:@hono/hono/test-utils",
        "tsx": "^4.20.3",
        "typescript": "^5.3.3",
        "vitest": "^3.2.4"
    }
}